# =============================================================================
# Coffee AI Challenge — environment template
# =============================================================================
# cp .env.example .env  and fill in the blanks.
# NEVER commit .env. If a key leaks, rotate it — don't rewrite history.
# =============================================================================

# --- LLM provider ------------------------------------------------------------
# Any OpenAI-compatible endpoint. Swap freely without touching game logic.
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

# For a local model instead:
#   LLM_PROVIDER=ollama
#   LLM_BASE_URL=http://host.docker.internal:11434/v1
#   LLM_MODEL=llama3.1
#   LLM_API_KEY=ollama

# Cost control. Attempt cap also enforced via challenge.yaml public.max_attempts.
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2

# --- Guardrail layer 2 (embeddings) --------------------------------------------
# Same endpoint + key as the chat model. With LLM_API_KEY empty, layer 2
# (PREFERENCE_DECLARATION) is inactive and only keyword rules run. If the call
# fails or times out, the guardrail fails OPEN — the prompt goes through.
# similarity_threshold in challenge.yaml is calibrated for this model.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_TIMEOUT_SECONDS=8

# --- Backend -----------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ALLOW_ORIGINS=http://localhost:3000
# CHALLENGE_CONFIG_PATH — where the backend reads the rules from. Leave unset for
# a local `uvicorn` run (defaults to the repo-root challenge.yaml). docker-compose
# sets it to /app/challenge.yaml, the mounted path.

# Admin endpoints (reset challenge, clear leaderboard). Simple shared token —
# not an auth system, and deliberately so. Change before any public deploy.
ADMIN_TOKEN=change-me

# --- Storage -----------------------------------------------------------------
# memory = fine for S1-S3. redis = required from S4 so a restart doesn't
# wipe the leaderboard mid-event.
STORE_BACKEND=memory
REDIS_URL=redis://redis:6379/0

# --- Frontend ----------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- OpenTelemetry -----------------------------------------------------------
# The app talks only to the collector. Backends are the collector's problem.
OTEL_SERVICE_NAME=coffee-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_TRACES_SAMPLER=parentbased_always_on

# --- Langfuse ----------------------------------------------------------------
# Generate a project API key pair in the Langfuse UI. LANGFUSE_BASE_URL (not
# the deprecated LANGFUSE_HOST) is what app.config.Settings reads.
#
# langfuse/docker-compose.yml runs as its own compose project ("langfuse"), on
# its own Docker network — not joined to this project's coffee-ai_default
# network — so a compose service name (http://langfuse-web:3000) does not
# resolve from coffee-backend, and this http://localhost:3002 value (correct
# for a bare host process: `make test`, a host-run `uvicorn`) does not resolve
# *inside* the coffee-backend container either — there "localhost" is the
# container itself. docker-compose.yml overrides this one var to
# http://host.docker.internal:3002 (the Docker-Desktop host gateway, same
# pattern as the Ollama LLM_BASE_URL example above) for the containerized run
# only; this file's value stays host-appropriate.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3002

# Tags every trace's "environment" attribute (Langfuse UI env filter). Local
# checkout default; set to "production"/"staging" on a real deploy.
APP_ENV=development

# --- Privacy -----------------------------------------------------------------
# Set false for public deployments, or add redaction before export.
LOG_PROMPTS=true
LOG_RESPONSES=true
